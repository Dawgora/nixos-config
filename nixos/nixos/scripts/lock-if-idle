#!/usr/bin/env sh

# Usage: lock-if-idle [lock|poweroff]
# Blocks the action if media is playing or a fullscreen window is focused.
ACTION="${1:-lock}"

for player in $(playerctl -l 2>/dev/null); do
  STATUS=$(playerctl status -p "$player" 2>/dev/null)
  if [ "$STATUS" = "Playing" ]; then
    exit 0
  fi
done

WINDOW_INFO=$(niri msg -j focused-window 2>/dev/null)
if echo "$WINDOW_INFO" | jq -e '.is_focused_fullscreen' >/dev/null 2>&1; then
  exit 0
fi

if [ "$ACTION" = "poweroff" ]; then
  exec niri msg action power-off-monitors
fi

exec lock-screen
