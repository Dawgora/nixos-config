#!/usr/bin/env sh

# Region screenshot, like hyprshot: the screen goes grey, drag a box,
# and on release it is saved to ~/Documents/Screenshots and copied to the clipboard.
# Esc (or pressing the key again) cancels.

DIR="$HOME/Documents/Screenshots"

# Second press while selecting: cancel
pkill -x slurp && exit 0

GEOMETRY=$(slurp -d) || exit 0

mkdir -p "$DIR"
FILE="$DIR/Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png"

grim -g "$GEOMETRY" "$FILE" || exit 1
wl-copy --type image/png < "$FILE"
notify-send -a Screenshot -i "$FILE" "Screenshot saved" "$FILE"
