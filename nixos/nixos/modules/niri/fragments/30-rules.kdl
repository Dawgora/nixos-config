prefer-no-csd

window-rule {
    open-maximized true
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// WezTerm initial-configure workaround
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Firefox PiP floats
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    open-on-workspace "main"
    match app-id=r#"^steam_app_"#
    match app-id=r#"^gamescope$"#
    open-maximized false
    variable-refresh-rate true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

  // Steam client on the middle screen (its notification toasts keep the rule above)
  window-rule {
      match app-id=r#"^steam$"#
      exclude title=r#"^notificationtoasts_\d+_desktop$"#
      open-on-workspace "main"
  }

// Chat and music on the right screen
window-rule {
    match app-id=r#"^org\.telegram\.desktop$"#
    match app-id=r#"^signal$"#
    match app-id=r#"^discord$"#
    match app-id=r#"^tidal-hifi$"#
    open-on-workspace "chat"
}

// Hide password manager and private chat from screen sharing (portal screencasts, OBS).
// Screenshots still show them.
window-rule {
    match app-id=r#"^bitwarden$"#
    match app-id=r#"^signal$"#
    block-out-from "screencast"
}
