output "HDMI-A-2" {
    mode "2560x1440@120"
    scale 1
    transform "90"
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "2560x1440@120"
    scale 1
    transform "normal"
    position x=1440 y=1120
}

output "DP-4" {
    mode "2560x1440@120"
    scale 1
    transform "270"
    position x=2880 y=0
}
